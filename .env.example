# DB — dev: local file, prod: libsql://<db>.turso.io
TURSO_DATABASE_URL=file:./local.db
TURSO_AUTH_TOKEN=

# Auth.js (required)
AUTH_SECRET=change-me-to-a-random-32+byte-secret

# Google OAuth (https://console.cloud.google.com/apis/credentials, callback …/api/auth/callback/google)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Vercel Blob (audio upload). Auto-injected when you connect a Blob store to the project.
BLOB_READ_WRITE_TOKEN=

# OpenAI (TAB image → tablature conversion). Restricted key, Model capabilities: Write.
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini  # optional override

# Admin emails (comma-separated). Listed accounts get moderation (/admin) access.
# (or set user.role='admin' directly in the DB)
AUTH_ADMIN_EMAILS=

# Dev-only mock login (creates a fake account by name). Disable/remove in production.
AUTH_DEV_LOGIN=1
