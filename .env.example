# DB — 개발: 로컬 파일, 운영: libsql://<db>.turso.io
TURSO_DATABASE_URL=file:./local.db
TURSO_AUTH_TOKEN=

# Auth.js (필수)
AUTH_SECRET=change-me-to-a-random-32+byte-secret

# Google OAuth (https://console.cloud.google.com/apis/credentials, 콜백 …/api/auth/callback/google)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# 개발 전용 모의 로그인(이름으로 가짜 계정 생성). 프로덕션에서는 비활성/제거.
AUTH_DEV_LOGIN=1
